  "ae_item_base_info_dto": {
    "mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S755169105b39432f8c7f35e0afb87a87J.jpg?has_lang=1&ver=1\",\"style\":{\"width\":800,\"height\":260,\"paddingBottom\":10}}},{\"type\":\"text\",\"data\":{\"content\":\"HOCHWERTIGES MATERIAL\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":16,\"fontWeight\":\"bold\",\"align\":\"left\",\"color\":\"#000000\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Hergestellt aus transparentem und umweltfreundlichem PP-Kunststoff, hochwertig, stark und langlebig.Unsere Produkte sind streng inspiriert.Für Sie bestellen, um eine hochwertige Einkaufserfahrung zu genießen\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"VERSCHIEDENE GRÖSSEN\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":16,\"fontWeight\":\"bold\",\"align\":\"left\",\"color\":\"#000000\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Es gibt mehr als 7er-Style-Aufbewahrungsboxen zur Auswahl, verschiedene Größen können Ihren anderen Bedarf treffen.\\n\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"EINFACH ZU VERWENDEN\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":16,\"fontWeight\":\"bold\",\"align\":\"left\",\"color\":\"#000000\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Einfach zu lagern und zu verwalten. Kleine Accessoires, Ohrringe, Ringe, Halsketten, Schnur, Perlen; Haken, Köder; Alphabettafel, Alphabet, DIY-Kunsthandwerk, Nägel, Muttern und Bolzen usw.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"VERSCHIEDENE VERWENDUNGEN\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":16,\"fontWeight\":\"bold\",\"align\":\"left\",\"color\":\"#000000\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"text\",\"data\":{\"content\":\"Sehr geeignet zum Aufbewahren von Diamanten, Samen, Perlen, Nagel-Strasssteinen, Tabletten, Ohrsteckern, Ringen und anderen kleinen Gegenständen.\",\"style\":{\"paddingLeft\":16,\"paddingRight\":16,\"paddingTop\":10,\"paddingBottom\":10,\"fontSize\":14,\"fontWeight\":\"regular\",\"align\":\"left\",\"color\":\"#666666\",\"fontFamily\":\"OpenSans\",\"backgroundColor\":\"#FFFFFF\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/S9769620ac74a420dbcedfd8433873105Y.jpg?has_lang=1&ver=1\",\"style\":{\"width\":800,\"height\":260,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sbcbf0d7f4be54bba95fb6361cf8e2796q.jpg\",\"style\":{\"height\":1000}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sbc4049fe6771422fb7a18b58f9b3a7abh.jpg?has_lang=1&ver=1\",\"style\":{\"width\":800,\"height\":260,\"paddingBottom\":10}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sa8a811611dc7498a8757613e7dbf5c05Q.jpg?has_lang=1&ver=1\",\"style\":{\"height\":800}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae01.alicdn.com/kf/Sfd5a0c41ef824b978ec78ca