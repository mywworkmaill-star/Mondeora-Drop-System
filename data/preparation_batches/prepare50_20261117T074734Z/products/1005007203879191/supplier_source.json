    "detail": "<div class=\"detailmodule_html\"><div class=\"detail-desc-decorate-richtext\"><div> \n <div> \n  <p id=\"tl_1\">Feature:</p> \n  <p id=\"tl_2\">Easy to carry.</p> \n  <p id=\"tl_3\">Each head with a Air holes, prevent bacterial growth.</p> \n  <p id=\"tl_4\">Keep your toothbrushes clean.</p> \n  <p id=\"tl_5\">With protective cover, great for traveling</p> \n  <p id=\"tl_6\">Specification:</p> \n  <p id=\"tl_7\">100% new and high quality all.</p> \n  <p id=\"tl_8\">Style:Convenient</p> \n  <p id=\"tl_9\">Material:pp</p> \n  <p id=\"tl_10\">Color:green/light gray/pink</p> \n  <p id=\"tl_11\">Size:19*6*6xm</p> \n  <p id=\"tl_12\">Package include:</p> \n  <p id=\"tl_13\">1 xTooth brush holder (other accessories demo in the picture is not included.)</p> \n  <p style=\"text-align:left;margin:0px;margin-bottom:0px;margin-top:0px;margin-left:0px;margin-right:0px\" align=\"left\"><img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S4f41581115314f419d01e0a25d3c57b93.jpg\" slate-data-type=\"image\" /><img src=\"https://ae-pic-a1.aliexpress-media.com/kf/Sb41c0917f0234ab4b0a16cc3db03b297Y.jpg\" slate-data-type=\"image\" /><img src=\"https://ae-pic-a1.aliexpress-media.com/kf/Scf2406f548924a4c97ec7a6086ff84beV.jpg\" slate-data-type=\"image\" /><img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S1f095dfbd82e473db7555cce83da5086b.jpg\" slate-data-type=\"image\" /><img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S693416dad43d4501b52580cd917c65f43.jpg\" slate-data-type=\"image\" /><img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S14dc512a73a54b7a83734a973f5252004.jpg\" slate-data-type=\"image\" /><img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S176088576dba452eb59d287a784be99ai.jpg\" slate-data-type=\"image\" /><img src=\"https://ae-pic-a1.aliexpress-media.com/kf/Scbfa2c3c115b43eebc062dc9203db594c.jpg\" slate-data-type=\"image\" /><img src=\"https://ae-pic-a1.aliexpress-media.com/kf/S39c2fa4f26ce43caa4bb517859eb4077e.jpg\" slate-data-type=\"image\" /><i