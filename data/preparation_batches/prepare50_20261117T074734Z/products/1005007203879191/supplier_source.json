    "mobile_detail": "{\"version\":\"2.0.0\",\"moduleList\":[{\"type\":\"text\",\"data\":{\"content\":\"Merkmale: \\n Leicht zu transportieren. \\n Jeder Kopf mit einem Luftlöchern, verhindert Bakterienwachstum. \\n Halten Sie Ihre Zahnbürsten sauber. \\n Mit Schutzhülle, ideal für unterwegs \\n Spezifikation: \\n 100 % neu und hochwertig. \\n Stil: Praktisch \\n Material:pp \\n Farbe: grün/hellgrau/rosa \\n Größe: 19*6*6xm \\n Das Paket enthalten: \\n 1 xZahnbürstenhalter (andere Zubehör-Demo im Bild ist nicht im Lieferumfang enthalten.)\",\"style\":{\"fontSize\":13,\"fontWeight\":\"\",\"align\":\"left\",\"color\":\"#434649\"}}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S4f41581115314f419d01e0a25d3c57b93.jpg\",\"style\":{\"width\":0,\"height\":0},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Sb41c0917f0234ab4b0a16cc3db03b297Y.jpg\",\"style\":{\"width\":0,\"height\":0},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Scf2406f548924a4c97ec7a6086ff84beV.jpg\",\"style\":{\"width\":0,\"height\":0},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S1f095dfbd82e473db7555cce83da5086b.jpg\",\"style\":{\"width\":0,\"height\":0},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S693416dad43d4501b52580cd917c65f43.jpg\",\"style\":{\"width\":0,\"height\":0},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S14dc512a73a54b7a83734a973f5252004.jpg\",\"style\":{\"width\":0,\"height\":0},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/S176088576dba452eb59d287a784be99ai.jpg\",\"style\":{\"width\":0,\"height\":0},\"targetUrl\":\"\"}},{\"type\":\"image\",\"data\":{\"url\":\"https://ae-pic-a1.aliexpress-media.com/kf/Scbfa2c3c115b